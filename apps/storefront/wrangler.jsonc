{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "cfshop-storefront",
	"compatibility_date": "2026-09-06",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Internal Worker→Worker link (no public Internet / *.workers.dev hop).
	// Local `next dev` uses STORE_API_URL or http://localhost:8787 instead.
	"services": [
		{
			"binding": "API",
			"service": "cfshop-api"
		}
	]
}
